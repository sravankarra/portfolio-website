# Copy this file to .env and fill in private values.
# Never commit .env, admin_auth.json, or .secret_key to Git.

SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-your-admin-password

# Mail account used only for password-reset emails
RESET_EMAIL=your-private-email@gmail.com
GMAIL_USER=your-private-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
